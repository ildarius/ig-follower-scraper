# Copy to .env.
#
# The follow queue is read from and written to the sunny_kratom database on
# seo.bizousoft.com, and nowhere else. The script opens its own SSH tunnel to the
# VPS and connects through it. There is no local fallback: Laragon's MySQL on
# this PC is never used, and the run refuses to start if the server it reaches
# is this PC.
#
# DB_HOST and DB_PORT are no longer read. The database is always reached at
# 127.0.0.1:DB_TUNNEL_LOCAL_PORT, the local end of the tunnel.

# ---------------------------------------------------------------------------
# Remote database. Required.
# ---------------------------------------------------------------------------
#
# Copy these from the 'db' block of the VPS copy of config.php:
#
#   ssh -p 22222 root@66.206.23.226 "grep -A6 'db' /home/bizousoft/public_html/seo/ig-follower-scraper/config.php"
#
# config.php 'name' -> DB_NAME, 'user' -> DB_USER, 'pass' -> DB_PASS.
DB_NAME=
DB_USER=
DB_PASS=

# ---------------------------------------------------------------------------
# SSH tunnel. The defaults below are what the script uses if these are absent.
# ---------------------------------------------------------------------------
# seo.bizousoft.com. The IP is used so the tunnel does not depend on DNS.
DB_SSH_HOST=66.206.23.226
DB_SSH_USER=root
DB_SSH_PORT=22222

# Private key for ssh -i. Leave empty to use the default key in
# C:\Users\ildar\.ssh, or to type the SSH password when the script prompts.
# A key is strongly preferred: if the tunnel drops during a six-hour run and
# has to be reopened, a password prompt waits 90 seconds and then gives up.
DB_SSH_KEY=

# Local end of the tunnel. 3306 is refused, because Laragon's MySQL uses it.
DB_TUNNEL_LOCAL_PORT=3307

# MySQL's port on the VPS.
DB_REMOTE_MYSQL_PORT=3306

# Optional. Once `node instagram-follower.js --check-db` has shown the VPS
# MySQL hostname, put it here and the script will refuse any other server.
DB_EXPECT_SERVER_HOSTNAME=

# Optional: only if ssh.exe is not on PATH.
# SSH_PATH=C:\Windows\System32\OpenSSH\ssh.exe

# Optional: only if chrome.exe is not in a standard location.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
